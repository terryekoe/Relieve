{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relieve",
  "version": "1.0.0",
  "identifier": "com.terryekoe.relieve",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Relieve — Presenter Console",
        "width": 1160,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      },
      {
        "label": "projector",
        "title": "Relieve — Projector Output",
        "url": "/projector",
        "width": 1280,
        "height": 720,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "resources": [
      "resources/bible.db",
      "resources/models/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
